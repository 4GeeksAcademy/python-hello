# Copia este archivo como .env y rellena los valores. Nunca subas .env a Git.

# Clave de la API de Groq (la usará el agente a partir de la Fase 5).
GROQ_API_KEY=

# Opcional: ruta del CSV de inventario. Si es relativa, se resuelve desde la raíz del proyecto.
# Por defecto: data/inventory.csv
# INVENTORY_CSV_PATH=data/inventory.csv

# Opcional: URL de la API de inventario que usa el agente.
# Por defecto: http://127.0.0.1:8000
# INVENTORY_API_URL=http://127.0.0.1:8000
